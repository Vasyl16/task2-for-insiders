# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://neondb_owner:npg_gTAyKBb30YfM@ep-red-pond-asshopxx-pooler.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Email (Resend) — payment receipts. Leave RESEND_API_KEY blank to skip
# sending and just log a warning; get a key at https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
